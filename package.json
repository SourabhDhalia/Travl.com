{
  "name": "travl-com",
  "version": "1.0.0",
  "description": "Scalable Express and Handlebars travel guide for Travl.com.",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test node --test"
  },
  "keywords": [
    "travel",
    "express",
    "handlebars",
    "mongodb"
  ],
  "author": "Sourabh Dhalia",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-handlebars": "^7.1.3",
    "express-session": "^1.19.0",
    "handlebars": "^4.7.9",
    "mongoose": "^8.24.0"
  },
  "overrides": {
    "handlebars": "^4.7.9"
  }
}
