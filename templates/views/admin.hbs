<section class="subhero admin-subhero">
  <div>
    <p class="eyebrow">Operations</p>
    <h1>Admin Panel</h1>
    <p>Manage destinations, review engagement signals, and check backend integration health from one place.</p>
  </div>
</section>

<section class="section admin-section">
  <div class="section-inner">
    {{#if statusMessage}}<p class="status-message">{{statusMessage}}</p>{{/if}}
    {{#if errorMessage}}<p class="alert error">{{errorMessage}}</p>{{/if}}

    <div class="admin-metrics">
      <article>
        <span>Destinations</span>
        <strong>{{admin.destinationCount}}</strong>
      </article>
      <article>
        <span>Submissions</span>
        <strong>{{admin.submissionCount}}</strong>
      </article>
      <article>
        <span>Currency API</span>
        <strong>{{admin.apiStatus.currencyProvider}}</strong>
      </article>
      <article>
        <span>MongoDB</span>
        <strong>{{#if admin.dbConnected}}Connected{{else}}Fallback{{/if}}</strong>
      </article>
    </div>

    <div class="admin-grid">
      {{#if (eq currentUser.email "admin@admin.com")}}
      <section class="admin-panel" style="display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 48px 24px;">
        <i class="fa fa-users" style="font-size: 3rem; color: var(--blue); margin-bottom: 18px;"></i>
        <h2>Admin Approvals</h2>
        <p style="margin-bottom: 24px; color: #666; max-width: 320px;">Manage pending admin access requests and approve or reject admin candidates.</p>
        <a href="/admin/approval" class="button secondary" style="padding: 12px 28px; text-decoration: none;">Manage Approvals</a>
      </section>
      {{/if}}

      <section class="admin-panel" style="display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 48px 24px;">
        <i class="fa fa-map-o" style="font-size: 3rem; color: var(--gold); margin-bottom: 18px;"></i>
        <h2>Manage Places</h2>
        <p style="margin-bottom: 24px; color: #666; max-width: 320px;">Create a new guide page with regional foods, maps, facts, and myths directly in the database.</p>
        <a href="/admin/destinations/new" class="button primary" style="padding: 12px 28px; text-decoration: none;">Add New Destination</a>
      </section>

      <section class="admin-panel">
        <h2>Content And API Health</h2>
        <div class="admin-list">
          <p><strong>Latest currency cache:</strong> {{admin.apiStatus.latestCurrencyCache}}</p>
          <p><strong>Protected destination flow:</strong> Login required before opening guide pages.</p>
          <p><strong>Content source:</strong> MongoDB when connected, seed fallback in local/test.</p>
        </div>

        <h3>Recent Submissions</h3>
        <div class="submission-list">
          {{#each admin.latestSubmissions}}
            <article style="border-top: 1px solid #e9e9e9; padding: 16px 0; display: flex; justify-content: space-between; align-items: start; gap: 12px;">
              <div>
                <strong>[{{type}}] {{name}}</strong>
                <span style="display: block; color: var(--muted); font-size: 0.88rem; margin: 2px 0 6px;">{{email}} {{#if subject}} - {{subject}}{{/if}}</span>
                <p style="margin: 0; line-height: 1.5; font-size: 0.95rem;">{{message}}</p>
              </div>
              <form action="/admin/submissions/{{_id}}/delete" method="POST" onsubmit="return confirm('Delete this message?');">
                <button class="button text-link" type="submit" style="color: var(--red); font-size: 0.85rem; padding: 2px 6px; text-decoration: none;">Delete</button>
              </form>
            </article>
          {{else}}
            <p>No submissions yet.</p>
          {{/each}}
        </div>
      </section>
    </div>

    <section class="admin-panel destination-admin-list" style="margin-top: 24px;">
      <h2>Destination Library</h2>
      <div class="admin-destination-list-container" style="display: grid; gap: 14px;">
        {{#each admin.destinations}}
          <div style="border: 1px solid #e5e5e5; border-radius: 8px; padding: 16px; display: flex; justify-content: space-between; align-items: center; background: #fff;">
            <div>
              <strong style="font-size: 1.1rem; color: #111;">{{name}}</strong>
              <small style="display: block; color: var(--muted); margin-top: 2px;">{{region}} {{#if featured}}(Featured){{/if}}</small>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
              <a href="/destinations/{{slug}}" target="_blank" class="button text-link" style="font-size: 0.9rem; text-decoration: none;">View Guide</a>
              <a href="/admin/destinations/{{_id}}/edit" class="button secondary" style="font-size: 0.88rem; padding: 6px 14px;">Edit</a>
              <form action="/admin/destinations/{{_id}}/delete" method="POST" onsubmit="return confirm('Delete this destination? This cannot be undone.');" style="margin: 0;">
                <button class="button text-link" type="submit" style="color: var(--red); font-size: 0.88rem; padding: 6px 10px; text-decoration: none;">Delete</button>
              </form>
            </div>
          </div>
        {{else}}
          <p>No destinations found in database.</p>
        {{/each}}
      </div>
    </section>
  </div>
</section>
