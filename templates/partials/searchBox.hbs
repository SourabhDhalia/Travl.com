<div class="search-box" data-search-root>
  <label class="sr-only" for="{{id}}">Search destinations</label>
  <input id="{{id}}" data-search-input type="search" autocomplete="off" placeholder="Type to search..." aria-controls="{{id}}-results">
  <button data-search-button type="button" aria-label="Open selected destination">Search</button>
  <ul class="search-results" id="{{id}}-results" data-search-results></ul>
</div>
